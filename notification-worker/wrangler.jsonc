{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anywhere-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "connect.jintongshu.com",
      "custom_domain": true
    }
  ],
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "IP_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTHORITY",
        "class_name": "RelayAuthority"
      }
    ]
  },
  "migrations": [
    {
      "tag": "network-v1-reverted",
      "new_sqlite_classes": [
        "RelayAuthority"
      ]
    }
  ],
  "vars": {
    "HOST_RELEASES": "[{\"codeHash\":\"0827ff26127379d42e7ba6a0ea6195c35a27077a2ee0ecc94f5f1ce0cf4810de\",\"build\":57},{\"codeHash\":\"8a2865d383ca17321400ebe5b9fb9342532b0a33ffb5060a9227056ba377a5a7\",\"build\":58},{\"codeHash\":\"54d8b16141be30125a0c846cf7d63315eb0d02d2f089a62b34301b78e3c02cde\",\"build\":59}]"
  }
}
